    "db:seed": "bun run scripts/seed.ts",
    "db:import-roster": "bun run scripts/import-roster.ts",
    "db:make-admin": "bun run scripts/make-admin.ts",
    "db:set-google-object": "bun run scripts/set-google-object.ts",
