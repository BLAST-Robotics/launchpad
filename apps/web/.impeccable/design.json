  "narrative": {
    "northStar": "The Launch Sequence",
    "overview": "LaunchPad is a countdown the student can follow: one clear step, then the next, ending in \"you're in\". Everything is built so a sixth grader on a phone can read it at arm's length and know what to do. Surfaces are white, edges are black, and the only loud thing is the team's own fire gradient, used as a short strip or a single emphasised word. Controls are large, flat and plain.",
    "keyCharacteristics": [
      "White paper, near-black ink, hairline grey borders. Light theme only.",
      "One accent red for the primary action; amber is a fill, never text on white.",
      "Wide heavy display face (Unbounded) over a friendly body face (Outfit), both self-hosted.",
      "Big targets: inputs 44px, buttons 40–48px.",
      "The fire gradient is a brand moment, not a texture."
    ],
    "rules": [
      {
        "name": "The One Press Rule",
        "body": "Ember Red marks the single primary action on a screen. If two things are red buttons, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Fill, Not Text Rule",
        "body": "Amber and the yellow end of the gradient never carry small text on white; they are fills, or they sit on black.",
        "section": "colors"
      },
      {
        "name": "The Display Is for Headings Rule",
        "body": "Unbounded is applied to h1–h3 and .font-display only; forms, tables and paragraphs stay in Outfit.",
        "section": "typography"
      },
      {
        "name": "The Flat Until Held Rule",
        "body": "Controls have no shadow. Only cards carry the one ambient shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep red for the one primary action per screen and white text on it (4.9:1).",
      "Do use the fire gradient as a 4px strip or a single emphasised word.",
      "Do use the team's real wordmark and shuttle images from public/brand/.",
      "Do keep controls at least 44px tall on phones and show the 2px ink focus ring everywhere.",
      "Do put amber on black or use it as a fill, and keep status colors paired with words, not color alone."
    ],
    "donts": [
      "Don't redraw, recolor or stretch the BLAST wordmark, the shuttle or the isometric mark.",
      "Don't set small text in amber or yellow on white.",
      "Don't put gradient text on paragraphs, buttons or labels.",
      "Don't add a dark theme without reworking the LaunchPad mark, whose outlines are black.",
      "Don't introduce a third accent hue; vermilion, orange and yellow live only inside the gradient."
    ]
  }
}