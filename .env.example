# Copy to .env.local and fill in. Never commit real values.
# On Vercel these are set through `vercel env add` / the dashboard.

# Neon pooled connection (runtime queries).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection (migrations only — never through PgBouncer).
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Better Auth. Min 32 characters; rotate = all sessions invalidated.
BETTER_AUTH_SECRET=
# Public origin of the app. http://localhost:3000 locally,
# https://launchpad.team10989.org in production.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (project "LaunchPad"). Scopes: openid email profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. When absent, error reporting is a no-op.
SENTRY_DSN=

# Optional. Port for `bun dev:api` (default 3000).
PORT=3000

# Temporary (D-022). "true" treats everyone on the roster as having signed the waiver and says
# so on the dashboard ("Signed (assumed for now)"). Set to "false" when e-sign is live.
WAIVERS_ASSUMED_SIGNED=true
# KeySign e-sign (D-008). Signing page embedded in an iframe on /waivers, and the HMAC secret
# that authenticates its completion webhook (POST /api/webhooks/keysign). Both optional.
KEYSIGN_SIGNING_URL=
KEYSIGN_WEBHOOK_SECRET=

# Google Groups membership check (read-only, optional). See docs/SETUP.md.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
